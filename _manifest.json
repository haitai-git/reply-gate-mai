{
  "manifest_version": 2,
  "version": "1.2.0",
  "name": "回复省流闸门",
  "description": "用你自己配置的便宜模型在进入 MaiBot planner 前判定该不该回复；判定不必回复时屏蔽主 planner 以节省 token，需要回复时再交给主 planner 完整规划。",
  "author": {
    "name": "haitai-git",
    "url": "https://github.com/haitai-git"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/haitai-git/reply-gate-mai",
    "homepage": "https://github.com/haitai-git/reply-gate-mai",
    "documentation": "https://github.com/haitai-git/reply-gate-mai/blob/main/README.md",
    "issues": "https://github.com/haitai-git/reply-gate-mai/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.3.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    }
  ],
  "capabilities": ["send.text"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "haitai-git.reply-gate-mai"
}